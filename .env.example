# GitHub Gist (required for Watchlist)
# Create a Gist at https://gist.github.com, then add a file named exactly: movielist.json
# Put a JSON array in it, e.g. [] or [{"id":"...","title":"...", ...}]
VITE_GIST_ID=your-gist-id-from-url
VITE_GIST_TOKEN=ghp_yourTokenWithGistScope

# OMDB (optional, for movie metadata)
VITE_OMDB_API_KEY=

# Google Places (optional, for place name autocomplete on Places tab)
VITE_GOOGLE_PLACES_API_KEY=

# Restart the dev server after changing .env
# Supabase (required)
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Minecraft Server (optional, for Minecraft launcher)
VITE_MINECRAFT_SERVER_ADDRESS=your-minecraft-server-ip
VITE_MINECRAFT_SERVER_PORT=25565
VITE_MINECRAFT_WEB_INTERFACE_PORT=8123
