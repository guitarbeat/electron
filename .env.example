# GitHub Gist (required for Watchlist)
# Create a Gist at https://gist.github.com, then add a file named exactly: movielist.json
# Put a JSON array in it, e.g. [] or [{"id":"...","title":"...", ...}]
VITE_GIST_ID=your-gist-id-from-url
# Server-only secret used by /api/gist for writes and private reads
GIST_TOKEN=ghp_yourTokenWithGistScope

# OMDB (optional, for movie metadata)
VITE_OMDB_API_KEY=

# Google Places (optional, for place name autocomplete on Places tab)
VITE_GOOGLE_PLACES_API_KEY=
