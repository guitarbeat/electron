# Local Vite-development fallback for shared state (optional)
VITE_DATABASE_URL=

# Client-side metadata and map configuration
# `VITE_OMDB_API_KEY` is only needed when `VITE_OMDB_API_URL` points directly at OMDb.
VITE_OMDB_API_URL=
VITE_OMDB_API_KEY=
VITE_TVMAZE_API_URL=
VITE_GOOGLE_PLACES_API_KEY=

# Server / serverless configuration
DATABASE_URL=
# Optional Vercel/Neon aliases also accepted by the shared-state store:
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=
# NEON_PROJECT_ID=
OMDB_API_URL=
# Required for the default `/api/omdb` proxy path.
OMDB_API_KEY=
TVMAZE_API_URL=
ALLOWED_ORIGINS=

# Set these as secrets in your deploy provider or local shell.
# Leaving them blank here will override real secret values if this file is loaded directly.
# SESSION_SIGNING_SECRET=
