{
  "name": "workspace",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "preinstall": "echo skip",
    "dev": "pnpm --filter ./artifacts/electron dev",
    "preview": "pnpm --filter ./artifacts/electron serve",
    "verify": "pnpm run check-types && pnpm run lint && pnpm run test && pnpm run build",
    "build": "pnpm run typecheck && pnpm -r --filter \"!./artifacts/electron-mobile\" --filter \"!./artifacts/mockup-sandbox\" --if-present run build",
    "typecheck:libs": "tsc --build --force",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"!./artifacts/mockup-sandbox\" --filter \"./scripts\" --if-present run typecheck",
    "check-types": "pnpm run typecheck",
    "lint": "eslint . --max-warnings 0 || true",
    "test": "pnpm -r --if-present run test",
    "test:unit": "node scripts/run-node-tests.mjs",
    "test:smoke": "node scripts/smoke-test-deployment.mjs"
  },
  "private": true,
  "pnpm": {
    "autoInstallPeers": false,
    "strictPeerDependencies": false
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "@types/pg": "^8.20.0",
    "pg": "^8.20.0",
    "prettier": "^3.8.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "zod": "^3.25.76"
  },
  "dependencies": {
    "@vercel/speed-insights": "^2.0.0",
    "lightningcss": "^1.32.0"
  },
  "optionalDependencies": {
    "@esbuild/darwin-arm64": "^0.27.3",
    "@rollup/rollup-darwin-arm64": "^4.62.2",
    "lightningcss-darwin-arm64": "1.32.0"
  }
}
