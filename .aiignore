# An .aiignore file follows the same syntax as a .gitignore file.
# Junie will ask for explicit approval before viewing or editing listed paths.

# Secrets and local env
.env*
env.txt
.neon

# Caches and build output
dist/
.vercel/
.next/
*.tsbuildinfo
node_modules/

# Agent ephemeral
.agents/scratch/
.agents/sessions/
.migration-backup/
