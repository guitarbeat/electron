      "@/branding/*": ["./apps/web/src/branding/*"],
      "@/common/*": ["./apps/web/src/components/common/*"],
      "@/components/*": ["./apps/web/src/components/*"],
      "@/effects/*": ["./apps/web/src/components/effects/*"],
      "@/hooks/*": ["./apps/web/src/hooks/*"],
      "@/matchmaker/*": ["./apps/web/src/components/matchmaker/*"],
      "@/quiz/*": ["./apps/web/src/components/quiz/*"],
      "@/services/*": ["./apps/web/src/services/*"],
