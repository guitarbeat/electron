<?xml version="1.0" encoding="utf-8"?>
<!-- Gold "Pick a movie" button style from the web app; a dark ring marks remote focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape><solid android:color="#F7D77A"/><corners android:radius="16dp"/><stroke android:width="4dp" android:color="#202C2C"/></shape></item>
    <item><shape><solid android:color="#F5C451"/><corners android:radius="16dp"/><stroke android:width="2dp" android:color="#A47B22"/></shape></item>
</selector>
