# Example Netlify config — copy to repo root as `netlify.toml` if deploying there.
# `/api/*` points at a placeholder backend; wire a real API origin before relying on shared state.

[build]
  command = "pnpm build"
  publish = "dist"

[[redirects]]
  from = "/api/*"
  to = "https://your-backend-host.example.com/api/:splat"
  status = 200
  force = true

[[redirects]]
  from = "/*"
  to = "/index.html"
  status = 200
