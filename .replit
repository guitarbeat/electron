modules = ["nodejs-20", "web"]
[agent]
expertMode = true
integrations = ["javascript_database:1.0.0"]
stack = "GAMESTACK_JS"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run dev"
waitForPort = 5000

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 3003
externalPort = 6000

[[ports]]
localPort = 3004
externalPort = 8008

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 23636
externalPort = 3000

[[ports]]
localPort = 23637
externalPort = 3003

[[ports]]
localPort = 23638
externalPort = 5173

[[ports]]
localPort = 23639
externalPort = 8000

[[ports]]
localPort = 23640
externalPort = 8080

[nix]
channel = "stable-25_05"
packages = ["gh"]

[userenv]

[userenv.shared]
# Shared state: set UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN (Replit Secrets) for sync.
VITE_OMDB_API_KEY = "3850ae42"
OMDB_API_KEY = "3850ae42"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[deployment]
deploymentTarget = "autoscale"
run = ["node", "./dist/index.cjs"]
build = ["npm", "run", "build"]
