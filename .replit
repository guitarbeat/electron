modules = ["nodejs-20", "web"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 24986
externalPort = 3000

[[ports]]
localPort = 24987
externalPort = 3002

[[ports]]
localPort = 25729
externalPort = 80

[nix]
channel = "stable-25_05"

[userenv]

# Set DATABASE_URL, OMDB_API_KEY, and VITE_OMDB_API_KEY via Replit Secrets (Tools → Secrets).
